---
import { getCollection } from 'astro:content';

const homePages = await getCollection('home');
const otherPages = await getCollection('pages');

const allNavItems = [
  ...homePages.map(p => ({ title: p.data.title, slug: p.data.slug, navOrder: p.data.navOrder ?? 1, showInNav: p.data.showInNav ?? true })),
  { title: 'blog', slug: '/blog', navOrder: 2, showInNav: true },
  { title: 'books', slug: '/books', navOrder: 4, showInNav: true },
  { title: 'travel', slug: '/travel', navOrder: 5, showInNav: true },
  ...otherPages.map(p => ({ title: p.data.title, slug: p.data.slug, navOrder: p.data.navOrder ?? 99, showInNav: p.data.showInNav ?? true })),
].filter(p => p.showInNav).sort((a, b) => a.navOrder - b.navOrder);

const currentPath = Astro.url.pathname;
---

<nav>
  {allNavItems.map((page) => (
    <a
      href={page.slug}
      aria-current={
        page.slug === '/'
          ? currentPath === '/' ? 'page' : undefined
          : currentPath.startsWith(page.slug) ? 'page' : undefined
      }
    >
      {page.title}
    </a>
  ))}
</nav>
