---
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';

const aboutEntry = await getEntry('pages', 'about');
const about = aboutEntry?.data as Record<string, string>;
---

<Base
  title="About"
  description="About — background, interests, and how to get in touch."
>
  <h1>about</h1>
  <div class="prose" set:html={about.body
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\[(.+?)\]\((.+?)\)/g, '<a href="$2">$1</a>')
    .replace(/\n\n/g, '</p><p>')
    .replace(/^/, '<p>')
    .replace(/$/, '</p>')
  } />
</Base>
