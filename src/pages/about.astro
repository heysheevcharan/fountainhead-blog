---
import Base from '../layouts/Base.astro';
---

<Base
  title="About"
  description="About Your Name — background, interests, and how to get in touch."
>
  <h1>about</h1>

  <div class="prose">
    <p>
      <!-- TODO: write your bio here -->
      Hi, I'm <strong>Your Name</strong>. I'm a software engineer based in Your City.
    </p>

    <p>
      I work on [what you work on]. I'm interested in [your interests].
    </p>

    <p>
      Outside of work, I enjoy [hobbies].
    </p>

    <h2>get in touch</h2>
    <p>
      The best way to reach me is by
      <a href="mailto:you@example.com">email</a>.
      I'm also on
      <a href="https://github.com/yourusername" target="_blank" rel="noopener">GitHub</a> and
      <a href="https://x.com/yourusername" target="_blank" rel="noopener">X</a>.
    </p>

    <h2>this site</h2>
    <p>
      Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>.
      Posts are written in MDX. No JavaScript is shipped to the browser.
      Source available on <a href="https://github.com/yourusername/blog" target="_blank" rel="noopener">GitHub</a>.
    </p>
