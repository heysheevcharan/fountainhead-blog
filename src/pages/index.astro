---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const allHomePages = await getCollection('home');
const homePage = allHomePages[0];
if (!homePage) throw new Error('home.mdx not found in src/content/home/');
const { Content } = await render(homePage);
const home = homePage.data;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: home.name ?? 'Sheev Charan',
  url: Astro.site,
  description: home.tagline,
  sameAs: [home.twitter, home.github, home.linkedin].filter(Boolean),
};

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<Base
  title="inspired by rebels"
  description="Sheev Charan writes about startups, product thinking, AI, creativity, and independent living. A blog inspired by rebels and contrarians."
>
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  <h1 style="margin-bottom: 0.75rem;">{home.name ?? home.title}</h1>
  {home.tagline && (
    <p class="text-muted" style="font-size: 1.1rem; margin-bottom: 2.5rem; line-height: 1.5;">{home.tagline}</p>
  )}

  <div class="prose">
    <Content />
  </div>

  {posts.length > 0 && (
    <>
      <hr class="divider" />
      <h2 style="margin-top: 0;">writing</h2>
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-list-item">
            <span class="log-date post-list-date">
              {formatDate(post.data.pubDate)}
            </span>
            <a href={`/blog/${post.id}`} class="post-list-link">
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
      <a href="/blog" class="text-muted" style="font-size: 0.875rem;">
        all posts &rarr;
      </a>
    </>
  )}

  {(home.email || home.github || home.twitter || home.linkedin) && (
    <>
      <hr class="divider" />
      <h2 style="margin-top: 0;">elsewhere</h2>
      <ul class="elsewhere-list">
        {home.email && <li><a href={`mailto:${home.email}`}>email</a></li>}
        {home.github && <li><a href={home.github} target="_blank" rel="noopener noreferrer">github</a></li>}
        {home.twitter && <li><a href={home.twitter} target="_blank" rel="noopener noreferrer">x.com</a></li>}
        {home.linkedin && <li><a href={home.linkedin} target="_blank" rel="noopener noreferrer">linkedin</a></li>}
      </ul>
    </>
  )}

  <hr class="divider" />
  <h2 style="margin-top: 0;">newsletter</h2>
  <p class="text-muted" style="font-size: 0.875rem; margin-bottom: 1.25rem;">
    Get new posts in your inbox.
  </p>
  <div class="substack-wrapper">
    <iframe
      src="https://sheevcharan.substack.com/embed"
      width="100%"
      height="150"
      frameborder="0"
      scrolling="no"
    ></iframe>
  </div>
</Base>
