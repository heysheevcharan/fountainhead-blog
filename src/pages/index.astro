---
import Base from '../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';
import { marked } from 'marked';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const homeEntry = await getEntry('pages', 'home');
const home = homeEntry?.data as Record<string, string>;

// Clean bearblog-specific syntax and render markdown
function renderBio(text: string): string {
  if (!text) return '';
  return marked.parse(
    text
      .replace(/==(.+?)==/g, '$1')           // strip ==highlight== syntax
      .replace(/\(tab:(https?[^)]+)\)/g, '($1)') // fix tab: links
  ) as string;
}

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<Base
  title={home.name}
  description={`Personal blog of ${home.name} — ${home.tagline}`}
>
  <h1>{home.name}</h1>
  <p class="text-muted" style="margin-bottom: 2rem;">{home.tagline}</p>

  <div class="prose" set:html={renderBio(home.bio)} />

  {posts.length > 0 && (
    <>
      <hr class="divider" />
      <h2 style="margin-top: 0;">writing</h2>
      <ul style="list-style: none; padding: 0;">
        {posts.map((post) => (
          <li style="margin-bottom: 1rem; display: flex; gap: 1rem; align-items: baseline;">
            <span class="text-muted" style="flex-shrink: 0; font-size: 0.8rem; font-variant-numeric: tabular-nums; min-width: 6.5rem;">
              {formatDate(post.data.pubDate)}
            </span>
            <a href={`/blog/${post.id}`} style="text-decoration-color: var(--border);">
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
      <a href="/blog" class="text-muted" style="font-size: 0.875rem;">
        all posts &rarr;
      </a>
    </>
  )}

  <hr class="divider" />
  <h2 style="margin-top: 0;">elsewhere</h2>
  <ul style="list-style: none; padding: 0; display: flex; gap: 1.25rem; flex-wrap: wrap;">
    {home.email && <li><a href={`mailto:${home.email}`}>email</a></li>}
    {home.github && <li><a href={home.github} target="_blank" rel="noopener">github</a></li>}
    {home.twitter && <li><a href={home.twitter} target="_blank" rel="noopener">x.com</a></li>}
    {home.linkedin && <li><a href={home.linkedin} target="_blank" rel="noopener">linkedin</a></li>}
  </ul>
</Base>
