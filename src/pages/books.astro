---
import Base from '../layouts/Base.astro';

import { fetchReadShelf } from '../lib/goodreads.js';
import bookYears from '../data/book-years.json';

type Book = { id: string; title: string; author: string; link: string };

// Years come from src/data/book-years.json, kept up to date nightly by
// scripts/sync-book-years.mjs. A book not synced yet counts as this year.
const years: Record<string, number> = bookYears;
const thisYear = new Date().getUTCFullYear();

let books: Book[] = [];
try {
  books = await fetchReadShelf();
} catch (e) {
  console.warn('[books] Could not load Goodreads shelf:', e);
}

// Group by year, keeping Goodreads' newest-first order within each year.
const grouped = new Map<number, Book[]>();
for (const book of books) {
  const year = years[book.id] ?? thisYear;
  grouped.set(year, [...(grouped.get(year) ?? []), book]);
}
const yearList = [...grouped.keys()].sort((a, b) => b - a);
---

<Base
  title="Books"
  description="Books I've read — pulled live from my Goodreads shelf."
>
  <h1>books</h1>
  <p class="text-muted" style="margin-bottom: 2.5rem;">
    {books.length} books read · via <a href="https://www.goodreads.com" target="_blank" rel="noopener noreferrer">Goodreads</a>
  </p>

  {yearList.map((year) => (
    <section style="margin-bottom: 2.5rem;">
      <h2 style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 1rem; margin-top: 0;">
        {year}
      </h2>
      <ul style="list-style: none; padding: 0;">
        {grouped.get(year)!.map((book) => (
          <li style="margin-bottom: 0.75rem;">
            <a href={book.link} target="_blank" rel="noopener noreferrer">
              {book.title}
            </a>
            {book.author && (
              <span class="text-muted"> — {book.author}</span>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}

  {books.length === 0 && (
    <p class="text-muted">Could not load books. Check back soon.</p>
  )}
</Base>

<style>
  a {
    text-decoration-color: var(--border);
  }
  a:hover {
    text-decoration-color: var(--link-hover);
  }
</style>
