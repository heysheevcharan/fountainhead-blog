---
import Base from '../layouts/Base.astro';

// Goodreads retired shelf RSS feeds (review/list_rss) in late Oct 2026; they now 404.
// The public shelf widget still works. It returns up to 100 books, newest read first,
// but no read dates, so the list is no longer grouped by year.
const WIDGET_URL = 'https://www.goodreads.com/review/custom_widget/74097056?shelf=read&sort=date_read&order=d&num_books=100&widget_id=1';

type Book = { title: string; author: string; link: string };
let books: Book[] = [];

// The widget is a JS file that assigns an escaped HTML string; unescape it as text.
const unescapeJs = (s: string) =>
  s.replace(/\\n/g, '\n').replace(/\\(["'\/\\])/g, '$1');

const decodeEntities = (s: string) =>
  s.replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;|&#x27;/g, "'")
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .trim();

try {
  const res = await fetch(WIDGET_URL);
  if (!res.ok) throw new Error(`Goodreads widget returned ${res.status}`);
  const html = unescapeJs(await res.text());

  const entries = html.split('class="gr_custom_each_container_1"').slice(1);

  books = entries.flatMap((entry) => {
    const titleMatch = entry.match(/class="gr_custom_title_1">\s*<a[^>]*href="([^"]+)"[^>]*>([\s\S]*?)<\/a>/);
    if (!titleMatch) return [];
    const author = entry.match(/class="gr_custom_author_1">[\s\S]*?<a[^>]*>([\s\S]*?)<\/a>/)?.[1] ?? '';
    const link = decodeEntities(titleMatch[1]).replace(/\?utm_medium=.*$/, '');
    return [{ title: decodeEntities(titleMatch[2]), author: decodeEntities(author), link }];
  });
} catch (e) {
  console.warn('[books] Could not load Goodreads shelf:', e);
}
---

<Base
  title="Books"
  description="Books I've read — pulled live from my Goodreads shelf."
>
  <h1>books</h1>
  <p class="text-muted" style="margin-bottom: 2.5rem;">
    {books.length} books read · via <a href="https://www.goodreads.com" target="_blank" rel="noopener noreferrer">Goodreads</a>
  </p>

  <ul style="list-style: none; padding: 0;">
    {books.map((book) => (
      <li style="margin-bottom: 0.75rem;">
        <a href={book.link} target="_blank" rel="noopener noreferrer">
          {book.title}
        </a>
        {book.author && (
          <span class="text-muted"> — {book.author}</span>
        )}
      </li>
    ))}
  </ul>

  {books.length === 0 && (
    <p class="text-muted">Could not load books. Check back soon.</p>
  )}
</Base>

<style>
  a {
    text-decoration-color: var(--border);
  }
  a:hover {
    text-decoration-color: var(--link-hover);
  }
</style>
