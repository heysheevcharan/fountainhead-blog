---
import Base from '../layouts/Base.astro';

const LIST_URL = 'https://letterboxd.com/sheevcharan/list/recommendations/';
const RSS_URL  = 'https://letterboxd.com/sheevcharan/rss/';

interface Film {
  title: string;
  url: string;
  year: string | null;
}

let films: Film[] = [];
let fetchError = false;

try {
  // ── Fetch list page + RSS in parallel ─────────────────────────────────────
  const [listRes, rssRes] = await Promise.all([
    fetch(LIST_URL, { headers: { 'User-Agent': 'Mozilla/5.0' } }),
    fetch(RSS_URL),
  ]);

  const [listHtml, xml] = await Promise.all([listRes.text(), rssRes.text()]);

  // ── Build slug → year map from RSS diary entries ───────────────────────────
  const yearMap = new Map<string, string>();
  const itemBlocks = [...xml.matchAll(/<item>([\s\S]*?)<\/item>/g)].map(m => m[1]);
  for (const block of itemBlocks) {
    const linkMatch = block.match(/<link>https:\/\/letterboxd\.com\/sheevcharan\/film\/([^/]+)\/<\/link>/);
    const yearMatch = block.match(/<letterboxd:filmYear>(\d+)<\/letterboxd:filmYear>/);
    if (linkMatch && yearMatch) yearMap.set(linkMatch[1], yearMatch[1]);
  }

  // ── Extract all film slugs from the list page HTML ────────────────────────
  const slugs = [...new Set(
    [...listHtml.matchAll(/\/film\/([a-z0-9][a-z0-9-]+[a-z0-9])\//g)]
      .map(m => m[1])
      .filter(s => !['films', 'add', 'edit', 'activity', 'watchlist', 'lists', 'diary', 'reviews', 'likes', 'tags', 'network', 'following', 'settings', 'about', 'pro', 'journal', 'apps', 'welcome', 'contact', 'legal'].includes(s))
  )];

  // ── Fetch each film page in parallel to get title + year ──────────────────
  const filmFetches = await Promise.allSettled(
    slugs.map(async (slug) => {
      // Use year from RSS if already known
      if (yearMap.has(slug)) {
        // Still need the title — get it from the film page
      }
      const r = await fetch(`https://letterboxd.com/film/${slug}/`, {
        headers: { 'User-Agent': 'Mozilla/5.0' },
      });
      const html = await r.text();
      const titleMatch = html.match(/<title>[^a-zA-Z0-9\u00C0-\u024F\u0400-\u04FF]*(.*?)\s*\((\d{4})\)\s+directed by/);
      const title = titleMatch ? titleMatch[1].replace(/^lrm;/, '').trim() : slug;
      const year = yearMap.get(slug) ?? titleMatch?.[2] ?? null;
      return { slug, title, url: `https://letterboxd.com/film/${slug}/`, year };
    })
  );

  films = filmFetches
    .filter(r => r.status === 'fulfilled')
    .map(r => (r as PromiseFulfilledResult<Film & { slug: string }>).value);

  // Sort chronologically by release year (oldest first)
  films.sort((a, b) => {
    const yearA = a.year ? parseInt(a.year, 10) : 0;
    const yearB = b.year ? parseInt(b.year, 10) : 0;
    return yearA - yearB;
  });

} catch (e) {
  fetchError = true;
}
---

<Base
  title="Films"
  description="Sheev Charan's personal film recommendations — movies worth watching, curated from Letterboxd."
>
  <h1>films</h1>
  <p class="text-muted" style="margin-bottom: 2.5rem;">
    {fetchError
      ? 'could not load films right now'
      : `${films.length} ${films.length === 1 ? 'film' : 'films'}`}
  </p>

  {!fetchError && films.length > 0 && (
    <ul class="film-list">
      {films.map((film) => (
        <li class="film-item">
          <a href={film.url} target="_blank" rel="noopener noreferrer" class="film-title">
            {film.title}
          </a>
          {film.year && (
            <span class="log-date film-year">{film.year}</span>
          )}
        </li>
      ))}
    </ul>
  )}

  {!fetchError && films.length === 0 && (
    <p class="text-muted">no films yet.</p>
  )}
</Base>

<style>
  .film-list {
    list-style: none;
    padding: 0;
  }

  .film-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--border);
  }

  .film-item:first-child {
    border-top: 1px solid var(--border);
  }

  .film-title {
    text-decoration: none;
    color: var(--text);
    font-size: 0.95rem;
  }

  .film-title:hover {
    color: var(--accent);
  }

  .film-year {
    flex-shrink: 0;
    font-size: 0.8rem;
  }
</style>
