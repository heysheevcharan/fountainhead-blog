---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const places = await getCollection('travel');
---

<Base
  title="Travel"
  description="Places I've been."
>
  <h1>travel</h1>
  <p class="text-muted" style="margin-bottom: 2.5rem;">
    {places.length} {places.length === 1 ? 'place' : 'places'}
  </p>

  {places.map((place) => (
    <section style="margin-bottom: 3rem;">
      <h2 style="font-size: 1rem; margin-bottom: 0.25rem; margin-top: 0;">
        {place.data.location}
      </h2>
      <p class="text-muted" style="font-size: 0.8rem; margin-bottom: 1rem;">
        {place.data.country}
      </p>

      {place.data.images.length > 0 ? (
        <div class="travel-grid">
          {place.data.images.map((img) => (
            <a href={img} target="_blank" rel="noopener noreferrer">
              <img
                src={img}
                alt={`${place.data.location}, ${place.data.country}`}
                loading="lazy"
              />
            </a>
          ))}
        </div>
      ) : (
        <p class="text-muted" style="font-size: 0.85rem;">photos coming soon</p>
      )}
    </section>
  ))}

  {places.length === 0 && (
    <p class="text-muted">No places yet.</p>
  )}
</Base>

<style>
  .travel-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  .travel-grid a {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 4px;
    border: 1px solid var(--border);
  }

  .travel-grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s;
    margin: 0;
    border: none;
    border-radius: 0;
  }

  .travel-grid a:hover img {
    opacity: 0.85;
  }

  @media (max-width: 480px) {
    .travel-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
